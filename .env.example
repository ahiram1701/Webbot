# Token compartido entre el servidor MCP y la extension. Genera uno largo y aleatorio
# y pegalo tambien en la pagina de opciones de la extension.
WEBBOT_TOKEN=cambia-esto-por-un-token-largo-y-aleatorio

# Puerto del puente WebSocket al que se conecta la extension.
WEBBOT_BRIDGE_PORT=8790
# Interfaz del puente. 127.0.0.1 en local; 0.0.0.0 solo dentro de Docker.
WEBBOT_BRIDGE_HOST=127.0.0.1

# Puerto del transporte MCP por HTTP (solo lo usa `npm run mcp:http`).
WEBBOT_HTTP_PORT=8791

# Milisegundos que espera el servidor la respuesta de la extension.
WEBBOT_REQUEST_TIMEOUT_MS=30000
