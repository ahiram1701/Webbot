# Token compartido entre el servidor MCP y la extension. Genera uno largo y aleatorio
# y pegalo tambien en la pagina de opciones de la extension.
WEBBOT_TOKEN=cambia-esto-por-un-token-largo-y-aleatorio

# Puerto del puente WebSocket al que se conecta la extension.
WEBBOT_BRIDGE_PORT=8790
# Interfaz del puente. 127.0.0.1 en local; 0.0.0.0 solo dentro de Docker.
WEBBOT_BRIDGE_HOST=127.0.0.1

# Puerto del transporte MCP por HTTP (solo lo usa `npm run mcp:http`).
WEBBOT_HTTP_PORT=8791
# Interfaz del transporte HTTP. /mcp no pide token, asi que dejalo en 127.0.0.1:
# en cualquier otra interfaz, cualquiera de tu red podria conducir tu navegador.
WEBBOT_HTTP_HOST=127.0.0.1

# Milisegundos que espera el servidor la respuesta de la extension.
WEBBOT_REQUEST_TIMEOUT_MS=30000

# --- Modelo que mueve el panel de la extension (opcional) ---
# Sin esto el servidor arranca igual y el camino MCP sigue entero; lo unico que se queda sin
# agente es el chat del panel lateral.
WEBBOT_LLM_PROVIDER=anthropic
WEBBOT_LLM_MODEL=claude-opus-5
WEBBOT_LLM_API_KEY=
# Con provider=anthropic tambien vale ANTHROPIC_API_KEY; con openai, OPENAI_API_KEY.

# 'openai' habla el formato /chat/completions, que es el que usan casi todos los demas.
# OpenAI:    WEBBOT_LLM_PROVIDER=openai  WEBBOT_LLM_MODEL=gpt-4.1  (base url por defecto)
# OpenRouter: WEBBOT_LLM_BASE_URL=https://openrouter.ai/api/v1
# NVIDIA NIM: WEBBOT_LLM_BASE_URL=https://integrate.api.nvidia.com/v1  (clave nvapi-...)
#             modelos en /v1/models; el catalogo retira modelos, comprueba antes de fijar uno.
# Ollama:     WEBBOT_LLM_BASE_URL=http://127.0.0.1:11434/v1  (sin clave)
WEBBOT_LLM_BASE_URL=

# El razonamiento adaptativo de los Claude 4.6 en adelante. 'off' para modelos mas antiguos,
# que devuelven 400 con ese parametro.
WEBBOT_LLM_THINKING=adaptive
